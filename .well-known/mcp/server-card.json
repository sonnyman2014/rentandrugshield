  "tools": [
    {
      "name": "audit_solana_token_10_layer",
      "title": "Solana 10-Layer Pre-Buy Token Anti-Rug Audit (<120ms)",
      "description": "<120ms pre-buy 10-layer Solana token safety gate over persistent keep-alive connections. Audits mint/freeze authorities, Token-2022 extensions (transfer fee, permanent delegate, transfer hook, default frozen), LP lock/burn status, top holder cluster concentration, exit liquidity solvency, Layer-8/9 Inner-CPI rent traps, pool age, and orderflow velocity. Includes 2 free pings and Solana x402 auto-upgrade.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string",
            "description": "Solana SPL or Token-2022 token mint address (base58) to audit pre-buy."
          },
          "pool_address": {
            "type": "string",
            "description": "Optional DEX liquidity pool or pair address (base58)."
          },
          "wallet": {
            "type": "string",
            "description": "Optional buyer Solana wallet public key (base58)."
          },
          "payment_signature": {
            "type": "string",
            "description": "Optional confirmed Solana transaction signature paying 89Sv5FvnMNRid1bn8y2Ti1vJPSxWxgiW9GSLsPpBnKK1 (0.026 SOL Option A or 0.00028 SOL Option B)."
          },
          "pro_pass_token": {
            "type": "string",
            "description": "Optional X-Pro-Pass-Token from Option A ($1.99 / 0.026 SOL Unlimited Pro Pass)."
          },
          "x_payment": {
            "type": "string",
            "description": "Optional base64 or JSON Solana x402 payment payload (X-Payment / PAYMENT-SIGNATURE) for automatic HTTP 402 settlement."
          }
        },
        "required": [
          "mint"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "10-Layer Solana Token Rug & Token-2022 Audit",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "simulate_solana_tx_drain",
      "title": "Layer-9 Inner-CPI Solana Transaction Drainer Simulator",
      "description": "Pre-sign Layer-9 Inner-CPI Solana transaction drainer check. Inspects base64 or base58 serialized transactions before wallet signing to block malicious inner CPI SOL drains, stealth SPL Approve/SetAuthority delegations, creator-vault rent traps, and unexpected balance deltas.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transaction": {
            "type": "string",
            "description": "Serialized Solana transaction (unsigned or signed) in base64 or base58."
          },
          "wallet": {
            "type": "string",
            "description": "Optional fee-payer/signer Solana wallet public key (base58)."
          },
          "encoding": {
            "type": "string",
            "enum": [
              "base64",
              "base58"
            ],
            "default": "base64",
            "description": "Encoding of the serialized transaction ('base64' or 'base58')."
          },
          "payment_signature": {
            "type": "string",
            "description": "Optional confirmed Solana transaction signature paying 89Sv5FvnMNRid1bn8y2Ti1vJPSxWxgiW9GSLsPpBnKK1 for x402 retry."
          },
          "pro_pass_token": {
            "type": "string",
            "description": "Optional X-Pro-Pass-Token from Option A Unlimited Pro Pass."
          },
          "x_payment": {
            "type": "string",
            "description": "Optional base64 or JSON Solana x402 payment payload (X-Payment / PAYMENT-SIGNATURE) for automatic HTTP 402 settlement."
          }
        },
        "required": [
          "transaction"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Layer-9 Inner-CPI Transaction Drainer Check",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "scan_wallet_unclaimed_sol",
      "title": "Read-Only Solana Wallet Unclaimed ATA & Token-2022 SOL Rent Scanner",
      "description": "Read-only Solana wallet ATA and Token-2022 rent scanner. Identifies empty and dust token accounts holding reclaimable SOL rent without requiring private keys, returning exact lamport, SOL, and USD recovery breakdowns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "Solana wallet public key (base58) to scan read-only for reclaimable ATA rent."
          },
          "include_token_2022": {
            "type": "boolean",
            "default": true,
            "description": "Include Token-2022 accounts alongside SPL Token accounts (default: true)."
          },
          "payment_signature": {
            "type": "string",
            "description": "Optional confirmed Solana transaction signature paying 89Sv5FvnMNRid1bn8y2Ti1vJPSxWxgiW9GSLsPpBnKK1 for x402 retry."
          },
          "pro_pass_token": {
            "type": "string",
            "description": "Optional X-Pro-Pass-Token from Option A Unlimited Pro Pass."
          },
          "x_payment": {
            "type": "string",
            "description": "Optional base64 or JSON Solana x402 payment payload (X-Payment / PAYMENT-SIGNATURE) for automatic HTTP 402 settlement."
          }
        },
        "required": [
          "wallet"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Read-Only Unclaimed ATA SOL Rent Scanner",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ],
