{
  "manifest_version": 3,
  "name": "Solana Rent & Rug Shield | Gemini 4 Carbon Crypto Cybersecurity Sentinel",
  "short_name": "Rent & Rug Shield",
  "version": "5.3.0",
  "version_name": "5.3",
  "description": "12-Layer Gemini 4 Carbon Shield v5.3: Carbon Black #020408 Notice Bubbles, Dark Control Filters, 3-State Sentinel & 0% 1st ATA SOL Claim.",
  "homepage_url": "https://rentandrugshield.com",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "tts",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Solana Rent & Rug Shield v5.3 | Carbon Black 12-Layer Sentinel",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://dexscreener.com/*",
        "https://*.dexscreener.com/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://jup.ag/*",
        "https://*.jup.ag/*",
        "https://raydium.io/*",
        "https://*.raydium.io/*",
        "https://app.meteora.ag/*",
        "https://*.meteora.ag/*",
        "https://meteora.ag/*",
        "https://photon-sol.tinyastro.io/*",
        "https://*.bullx.io/*",
        "https://bullx.io/*",
        "https://birdeye.so/*",
        "https://*.birdeye.so/*"
      ],
      "css": [
        "content_shield.css"
      ],
      "js": [
        "content_shield.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "toast_overlay.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png",
        "carbon-toast.html",
        "carbon-toast.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
