{
  "manifest_version": 3,
  "name": "Solana Rent & Rug Shield | 12-Layer Pre-Buy Crypto Sentinel v6.7",
  "short_name": "Rent & Rug Shield",
  "version": "6.7.0",
  "version_name": "6.7",
  "description": "12-Layer Solana Pre-Buy Security v6.7: Auto-Scan 0x09 Rent Collect, Liquidity Slider, Signal Tooltips & 12 Spoken Neural Voices.",
  "homepage_url": "https://rentandrugshield.com",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Solana Rent & Rug Shield v6.7 | 12-Layer Sentinel & Auto-Scan Collect",
    "default_icon": {
      "16": "icons/shield_yellow_16.png",
      "32": "icons/shield_yellow_32.png",
      "48": "icons/shield_yellow_48.png",
      "128": "icons/shield_yellow_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://dexscreener.com/*",
        "https://*.dexscreener.com/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://jup.ag/*",
        "https://*.jup.ag/*",
        "https://raydium.io/*",
        "https://*.raydium.io/*",
        "https://app.meteora.ag/*",
        "https://*.meteora.ag/*",
        "https://meteora.ag/*",
        "https://photon-sol.tinyastro.io/*",
        "https://*.bullx.io/*",
        "https://bullx.io/*",
        "https://birdeye.so/*",
        "https://*.birdeye.so/*"
      ],
      "css": [
        "content_shield.css"
      ],
      "js": [
        "content_shield.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "toast_overlay.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png",
        "icons/shield_yellow_16.png",
        "icons/shield_yellow_32.png",
        "icons/shield_yellow_48.png",
        "icons/shield_yellow_128.png",
        "icons/shield_yellow_256.png",
        "icons/shield_red_16.png",
        "icons/shield_red_32.png",
        "icons/shield_red_48.png",
        "icons/shield_red_128.png",
        "icons/shield_red_256.png",
        "icons/shield_emerald_16.png",
        "icons/shield_emerald_32.png",
        "icons/shield_emerald_48.png",
        "icons/shield_emerald_128.png",
        "icons/shield_emerald_256.png",
        "carbon-toast.html",
        "carbon-toast.js",
        "sounds/*.wav",
        "sounds/voices_manifest_v67.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/shield_yellow_16.png",
    "32": "icons/shield_yellow_32.png",
    "48": "icons/shield_yellow_48.png",
    "128": "icons/shield_yellow_128.png"
  }
}
